# ─── pulse-ingestor configuration ────────────────────────────────────────────
#
# Values below target the LOCAL development stack in ../pulse-infra. Bring it up
# with `make up PROFILE=core` (Kafka + fake GCS — this service's whole world) or
# `make up` for everything.
#
# Every name here is a CROSS-REPO CONTRACT. The authority is
# ../pulse-infra/docs/stack-contract.md; changing a topic name, bucket or path
# convention breaks four-plus repos.

# ── Kafka source ─────────────────────────────────────────────────────────────
# From the host. From inside the pulse-infra Docker network instead use:
#   kafka-1:9092,kafka-2:9092,kafka-3:9092
KAFKA_BOOTSTRAP_SERVERS=localhost:19092,localhost:19093,localhost:19094

KAFKA_TOPIC_EVENTS=ingestion-events
KAFKA_TOPIC_SIGNALS=ingestion-signals
KAFKA_TOPIC_LOGS=ingestion-logs

# This service OWNS its consumer group: the stack creates no groups, so
# XGROUP/consumer-group creation, partition assignment and the pending-message
# handling are all yours.
KAFKA_CONSUMER_GROUP=pulse-ingestor-local

# Topics are 6 partitions each in the local stack (RF=3 on core/full, RF=1 on
# lite). 6 divides by 1/2/3/6 so rebalancing is observable at any group size.
# Auto-topic-creation is OFF upstream: a misspelled topic is an error, not an
# empty stream.

# ── Commit semantics: NOT configurable, on purpose ───────────────────────────
# Commit AFTER a successful upload, never before — an offset committed ahead of
# a durable write is silent data loss on the next rebalance.
#
# `enable.auto.commit=false`, `enable.auto.offset.store=false` and
# `auto.offset.reset=earliest` are set in code (src/kafka.rs) and deliberately
# have no environment keys. Auto-commit runs on a timer that knows nothing about
# whether the batch reached GCS; a `.env` typo must not be able to switch the
# service's one correctness property off.

# ── Batching: fixed offset ranges ────────────────────────────────────────────
# DECIDED: batches are cut at FIXED offset boundaries per partition, not by
# whatever happens to be buffered when a timer fires.
#
# Why this matters. Object names embed the offset range, so a retry that
# reproduces the same range overwrites the same object and the write is
# idempotent with no transaction. But that only holds if the boundaries are
# reproducible: after a rebalance, a consumer that batches "whatever it has"
# produces a DIFFERENT range covering the same events, which writes a second,
# overlapping object. Fixed boundaries make the name a deterministic function of
# the data, so retries and reassignments converge instead of duplicating.
#
# A batch therefore covers [floor(offset/N)*N, floor(offset/N)*N + N - 1].
BATCH_OFFSET_RANGE=10000

# Flush a partial (trailing) batch after this long so a low-traffic topic is not
# stuck waiting for a full range. A partial batch is written to the SAME object
# name its full range would use, so completing it later overwrites in place.
BATCH_MAX_IDLE_MS=30000

# ── GCS staging sink ─────────────────────────────────────────────────────────
# fake-gcs-server is unauthenticated and HTTP-only, so NO credentials are
# needed locally. Point the GCS client at the emulator instead.
# From inside the pulse-infra network use fake-gcs:4443.
STORAGE_EMULATOR_HOST=localhost:4443
GCS_BUCKET=pulse-staging-local

# Object path convention — also NOT configurable. "staging", never "bronze": a
# transient landing pad with no retention promise.
#   {topic}/dt=YYYY-MM-DD/{partition}-{startoffset}-{endoffset}.parquet
# e.g. ingestion-events/dt=2026-09-13/0-0-9999.parquet
#
# The name IS the idempotency guarantee: a retry overwrites because it derives
# the same name from the same offsets. A runtime template would let a config
# edit change the name of a range that was already written, turning the next
# retry into a duplicate rather than an overwrite. It lives in
# ObjectName::for_range (src/batching.rs), where changing it is a code review.
#
# The date is the WRITE date in UTC, not an event timestamp.

# ── WARNING: what local CANNOT tell you ──────────────────────────────────────
# fake-gcs has no IAM, returns different error bodies, and serves plain HTTP.
# The GCS write path is therefore UNVERIFIED FOR AUTH until the dev environment:
# scopes, ADC, token refresh, 401-vs-403-vs-429 handling and TLS are all
# untested locally. A green local run is not a deployable artifact.
# See ../pulse-infra/docs/divergences.md.

# ── Runtime ──────────────────────────────────────────────────────────────────
# Standard tracing filter, e.g. `info`, or `pulse_ingestor=debug,rdkafka=warn`
# to see every consumed offset.
RUST_LOG=info
